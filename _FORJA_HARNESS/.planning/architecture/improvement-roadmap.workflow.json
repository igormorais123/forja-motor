{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "FORJA Harness — roadmap de melhoria",
    "subtitle": "Ondas pequenas, gates e reversibilidade",
    "output": "FORJA_HARNESS_IMPROVEMENT_ROADMAP.html",
    "visual_preset": "blueprint",
    "animation": "none",
