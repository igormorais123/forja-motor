        "note": "Executar em ordem; cada onda exige evidência."
      },
      {
        "id": "failure",
        "label": "Gate de parada",
        "focus": [
          "wave0",
          "block"
        ],
        "note": "Paridade ou regressão interrompe a migração."
      }
    ]
  },
  "lanes": [
    {
      "id": "baseline",
      "label": "Baseline"
    },
    {
      "id": "boundary",
      "label": "Fronteiras"
