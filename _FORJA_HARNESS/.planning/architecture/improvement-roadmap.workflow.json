    {
      "id": "migration",
      "label": "Migração"
    },
    {
      "id": "quality",
      "label": "Qualidade"
    },
    {
      "id": "exception",
      "label": "Bloqueios",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "stabilize",
      "label": "Estabilizar",
      "fromCol": 0,
      "toCol": 2
