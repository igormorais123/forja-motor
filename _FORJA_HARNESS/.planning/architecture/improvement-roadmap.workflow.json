  "cards": [
    {
      "dot": "cyan",
      "title": "Sequência",
      "items": [
        "Baseline antes da mudança",
        "Uma fronteira por onda"
      ]
    },
    {
      "dot": "rose",
      "title": "Gate",
      "items": [
        "Falha interrompe promoção",
        "Rollback permanece disponível"
      ]
    },
    {
      "dot": "emerald",
      "title": "Aceite",
      "items": [
        "Contrato e teste",
        "Métrica antes/depois"
      ]
    }
