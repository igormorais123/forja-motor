{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture_candidate.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "lineage",
    "candidateId",
    "title",
    "status",
    "producerRunId",
    "sourceHashes",
    "sourceSnapshot",
    "baselineTreeHash",
    "candidateTreeHash",
    "candidatePatchHash",
    "proposal",
    "experiments",
    "metrics",
    "rollback",
    "createdAt",
    "updatedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lineage": {
      "const": "AR-Architecture"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "enum": [
        "proposed",
        "shadow_passed",
        "canary_passed",
        "independently_reviewed",
        "rollback_rehearsed",
        "estudo_descritivo",
        "rejected",
        "rolled_back"
      ]
    },
    "producerRunId": {
      "type": "string",
      "minLength": 1
    },
    "reviewerRunId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "sourceSnapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "baselineTreeHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "candidateTreeHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidatePatchHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposal": {
      "type": "object",
      "required": [
        "problem",
        "hypothesis",
        "scope",
        "productionMutation"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 20
        },
        "hypothesis": {
          "type": "string",
          "minLength": 20
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "productionMutation": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "experiments": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "review": {
      "type": [
        "object",
        "null"
      ]
    },
    "rollback": {
      "type": "object",
      "required": [
        "recipe",
        "rehearsed",
        "passed"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
